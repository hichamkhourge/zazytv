# Flask API Configuration
# API Key for authentication (shared secret with iptvProvider — generate a strong random string)
API_KEY=change_me_to_a_strong_random_secret
# Port for Flask API server (default: 8899)
PORT=8899
HOST=0.0.0.0
# Flask debug mode (use False in production)
FLASK_DEBUG=False

# Webhook Authentication Token for Laravel callbacks
# This must match ZAZY_WEBHOOK_TOKEN in iptvProvider .env
WEBHOOK_AUTH_TOKEN=change_me_to_another_strong_random_secret

# 2captcha Configuration
# Get your API key from https://2captcha.com/enterpage
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# URLs
BASE_URL=https://zazyhost.com
HOME_URL=https://zazytv.com/

# Login Credentials (optional - only needed if SKIP_LOGIN=False)
LOGIN_EMAIL=your@email.com
LOGIN_PASSWORD=yourpassword
SKIP_LOGIN=True

# Promo Code (optional)
PROMO_CODE=

# IBO Player Configuration
# Get these values from your IBO Player account
# Cookie: From browser DevTools > Application > Cookies while logged into iboplayer.com
IBOPLAYER_COOKIE=your_iboplayer_cookie_here
# Playlist URL ID: From IBO Player device settings
IBOPLAYER_PLAYLIST_URL_ID=your_playlist_url_id_here
# Playlist Name: Display name for your playlist
IBOPLAYER_PLAYLIST_NAME=Zazy
# Playlist URL: Xtream Codes server URL
IBOPLAYER_PLAYLIST_URL=http://live.zazytv.com

# Telegram Notification Configuration (Optional)
# Get your bot token from @BotFather on Telegram
# See TELEGRAM_SETUP.md for detailed instructions
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Docker/Automation Settings (Optional)
# HEADLESS: Run Chrome in headless mode (True for Docker, False for local GUI)
HEADLESS=True
# AUTO_EXIT: Exit after completion (True for Docker/cron, False to keep browser open)
AUTO_EXIT=True
# TZ: Timezone for cron schedule (e.g., America/New_York, Europe/London, Asia/Dubai)
TZ=UTC

# ═══════════════════════════════════════════════════════════
# UGEEN API Scraper Configuration
# ═══════════════════════════════════════════════════════════

# UGEEN Service Credentials
# Your UGEEN.LIVE login credentials
UGEEN_EMAIL=your_ugeen_email@example.com
UGEEN_PASSWORD=your_ugeen_password

# UGEEN Configuration
UGEEN_URL=http://ugeen.live
UGEEN_PACKAGE_ID=384

# UGEEN Automation Settings
# UGEEN_HEADLESS: Run Chrome in headless mode for ugeen scraper
UGEEN_HEADLESS=True
# UGEEN_SESSION_DIR: Directory to store session files (default: ./ugeen_sessions)
UGEEN_SESSION_DIR=./ugeen_sessions
# UGEEN_DATA_DIR: Directory to store scraped data (default: ./ugeen_data)
UGEEN_DATA_DIR=./ugeen_data

# UGEEN Production Reliability Settings (for Docker/headless environments)
# CAPTCHA_POST_SOLVE_WAIT: Seconds to wait after solving CAPTCHA before submitting (default: 3)
# NOTE: Reduced to prevent CAPTCHA token from expiring/becoming stale
CAPTCHA_POST_SOLVE_WAIT=3
# SUBMIT_BUTTON_TIMEOUT: Max seconds to wait for submit button to appear (default: 20)
SUBMIT_BUTTON_TIMEOUT=20
# SUBMIT_MAX_RETRIES: Number of submit button click attempts (default: 3)
SUBMIT_MAX_RETRIES=3

# LayerSeven Automation Configuration
LAYERSEVEN_BASE_URL=https://layerseveniptv.io
LAYERSEVEN_CART_URL=https://layerseveniptv.io/billing/cart.php?a=confproduct&i=0
LAYERSEVEN_DEVICE_TYPE=Smart TV (Samsung/Sony/LG)
# all = select every visible bouquet checkbox in the selector modal
LAYERSEVEN_BOUQUET_MODE=all
# Poll client-area email history until the account-ready email arrives
LAYERSEVEN_EMAIL_POLL_SECONDS=10
LAYERSEVEN_EMAIL_MAX_WAIT_SECONDS=420
# Optional fallback if the ready email does not expose a portal URL cleanly
LAYERSEVEN_PORTAL_HOST=
