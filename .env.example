# Flask API Configuration
# API Key for authentication (shared secret with iptvProvider — generate a strong random string)
API_KEY=change_me_to_a_strong_random_secret
# Port for Flask API server (default: 8899)
PORT=8899
HOST=0.0.0.0
# Flask debug mode (use False in production)
FLASK_DEBUG=False

# Webhook Authentication Token for Laravel callbacks
# This must match ZAZY_WEBHOOK_TOKEN in iptvProvider .env
WEBHOOK_AUTH_TOKEN=change_me_to_another_strong_random_secret

# 2captcha Configuration
# Get your API key from https://2captcha.com/enterpage
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# URLs
BASE_URL=https://zazyhost.com
HOME_URL=https://zazytv.com/

# Login Credentials (optional - only needed if SKIP_LOGIN=False)
LOGIN_EMAIL=your@email.com
LOGIN_PASSWORD=yourpassword
SKIP_LOGIN=True

# Promo Code (optional)
PROMO_CODE=

# IBO Player Configuration
# Get these values from your IBO Player account
# Cookie: From browser DevTools > Application > Cookies while logged into iboplayer.com
IBOPLAYER_COOKIE=your_iboplayer_cookie_here
# Playlist URL ID: From IBO Player device settings
IBOPLAYER_PLAYLIST_URL_ID=your_playlist_url_id_here
# Playlist Name: Display name for your playlist
IBOPLAYER_PLAYLIST_NAME=Zazy
# Playlist URL: Xtream Codes server URL
IBOPLAYER_PLAYLIST_URL=http://live.zazytv.com

# Telegram Configuration
# Get your bot token from @BotFather on Telegram
# See TELEGRAM_SETUP.md for detailed instructions
# TELEGRAM_ENABLED controls both notifications AND the interactive bot
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram Bot Settings (Optional - for interactive commands)
# These control the polling behavior of the Telegram bot
# TELEGRAM_BOT_POLL_INTERVAL: Seconds between polls (default: 1.0)
# TELEGRAM_BOT_TIMEOUT: Long polling timeout in seconds (default: 30)
TELEGRAM_BOT_POLL_INTERVAL=1.0
TELEGRAM_BOT_TIMEOUT=30

# Docker/Automation Settings (Optional)
# HEADLESS: Run Chrome in headless mode (True for Docker, False for local GUI)
HEADLESS=True
# AUTO_EXIT: Exit after completion (True for Docker/cron, False to keep browser open)
AUTO_EXIT=True
# IPTVV_DEBUG_DIR: Where IPTVV Cloudflare/preflight screenshots and HTML are saved
IPTVV_DEBUG_DIR=/app/logs
# IPTVV_PROXY_CHECK_URL: URL Chrome opens to print browser-visible public IP during preflight
IPTVV_PROXY_CHECK_URL=https://api.ipify.org

# IPTVV_KNOWN_BLOCKED_IP: Optional; preflight warns if Chrome still exits from this IP
IPTVV_KNOWN_BLOCKED_IP=
# IPTVV_CLOUDFLARE_WAIT_SECONDS: Max wait for checkout to clear Cloudflare before failing
IPTVV_CLOUDFLARE_WAIT_SECONDS=45
# IPTVV_PAGE_LOAD_RETRIES: Refresh attempts when a Cloudflare/WAF page is detected
IPTVV_PAGE_LOAD_RETRIES=2

# --- IPTVV temporary email backend ---
# IPTVV_EMAIL_BACKEND: Where the receiving address comes from.
#   procmail = api.procmail.xyz REST API (powers 8gwifi.org/temp-email.jsp) (default)
#   mailtm   = legacy mail.tm REST API (fallback)
IPTVV_EMAIL_BACKEND=procmail
# PROCMAIL_API_BASE: REST base for the procmail backend (override only if mirrored)
PROCMAIL_API_BASE=https://api.procmail.xyz
# IPTVV_EMAIL_POLL_SECONDS / IPTVV_EMAIL_MAX_WAIT_SECONDS: inbox poll interval / total wait
IPTVV_EMAIL_POLL_SECONDS=30
IPTVV_EMAIL_MAX_WAIT_SECONDS=2700

# Note: The automation runs on the host's public IP with a direct connection.
# All proxy support (Tor, Webshare, BrightData) has been removed.

# ═══════════════════════════════════════════════════════════
# IPTVV - IBO Player Integration (Auto-send credentials)
# ═══════════════════════════════════════════════════════════
# IPTVV_IBOPLAYER_ENABLED: Enable automatic sending of IPTVV credentials to IBO Player
IPTVV_IBOPLAYER_ENABLED=False
# IPTVV_IBOPLAYER_COOKIE: Your IBO Player session cookie (get from browser DevTools)
# How to get: 1) Login to https://iboplayer.com 2) Open DevTools > Application > Cookies
# Copy the entire cookie string (including all session/CSRF tokens)
IPTVV_IBOPLAYER_COOKIE=
# IPTVV_IBOPLAYER_PLAYLIST_URL_ID: Your IBO Player device playlist ID
# Find this in IBO Player device settings or playlist management page
IPTVV_IBOPLAYER_PLAYLIST_URL_ID=
# IPTVV_IBOPLAYER_PLAYLIST_NAME: Display name for IPTVV playlist in IBO Player (optional)
IPTVV_IBOPLAYER_PLAYLIST_NAME=IPTVV Canada
# IPTVV_IBOPLAYER_PLAYLIST_URL: IPTVV server URL template (usually auto-detected from credentials)
IPTVV_IBOPLAYER_PLAYLIST_URL=http://iptvvcanada.com

# TZ: Timezone for cron schedule (e.g., America/New_York, Europe/London, Asia/Dubai)
TZ=UTC

# ═══════════════════════════════════════════════════════════
# UGEEN API Scraper Configuration
# ═══════════════════════════════════════════════════════════

# UGEEN Service Credentials - Multi-Account Support
# Configure multiple UGEEN accounts for automated renewals
# The ugeen_multi_account.py script will process all configured accounts sequentially
# Add as many accounts as needed by incrementing the number (1, 2, 3, etc.)

# Account 1
UGEEN_ACCOUNT_1_EMAIL=your_ugeen_email_1@example.com
UGEEN_ACCOUNT_1_PASSWORD=your_ugeen_password_1

# Account 2
UGEEN_ACCOUNT_2_EMAIL=your_ugeen_email_2@example.com
UGEEN_ACCOUNT_2_PASSWORD=your_ugeen_password_2

# Account 3
UGEEN_ACCOUNT_3_EMAIL=your_ugeen_email_3@example.com
UGEEN_ACCOUNT_3_PASSWORD=your_ugeen_password_3

# Legacy single-account variables (kept for backward compatibility with direct script calls)
UGEEN_EMAIL=your_ugeen_email@example.com
UGEEN_PASSWORD=your_ugeen_password

# UGEEN Configuration
UGEEN_URL=http://ugeen.live
UGEEN_PACKAGE_ID=384

# UGEEN Automation Settings
# UGEEN_HEADLESS: Run Chrome in headless mode for ugeen scraper
UGEEN_HEADLESS=True
# UGEEN_SESSION_DIR: Directory to store session files (default: ./ugeen_sessions)
UGEEN_SESSION_DIR=./ugeen_sessions
# UGEEN_DATA_DIR: Directory to store scraped data (default: ./ugeen_data)
UGEEN_DATA_DIR=./ugeen_data

# UGEEN Production Reliability Settings (for Docker/headless environments)
# CAPTCHA_POST_SOLVE_WAIT: Seconds to wait after solving CAPTCHA before submitting (default: 3)
# NOTE: Reduced to prevent CAPTCHA token from expiring/becoming stale
CAPTCHA_POST_SOLVE_WAIT=3
# SUBMIT_BUTTON_TIMEOUT: Max seconds to wait for submit button to appear (default: 20)
SUBMIT_BUTTON_TIMEOUT=20
# SUBMIT_MAX_RETRIES: Number of submit button click attempts (default: 3)
SUBMIT_MAX_RETRIES=3

# LayerSeven Automation Configuration
LAYERSEVEN_BASE_URL=https://layerseveniptv.io
LAYERSEVEN_CART_URL=https://layerseveniptv.io/billing/cart.php?a=confproduct&i=0
LAYERSEVEN_DEVICE_TYPE=Smart TV (Samsung/Sony/LG)
# all = select every visible bouquet checkbox in the selector modal
LAYERSEVEN_BOUQUET_MODE=all
# Poll client-area email history until the account-ready email arrives
LAYERSEVEN_EMAIL_POLL_SECONDS=10
LAYERSEVEN_EMAIL_MAX_WAIT_SECONDS=420
# Optional fallback if the ready email does not expose a portal URL cleanly
LAYERSEVEN_PORTAL_HOST=

# IPTVtune Automation Configuration
# WHMCS store at https://iptvtune.com/pay/ ; free "1 Day Free Trial" product.
IPTVTUNE_BASE_URL=https://iptvtune.com
IPTVTUNE_CART_URL=https://iptvtune.com/pay/cart.php?a=confproduct&i=0
IPTVTUNE_DEVICE_TYPE=Smart TV (Samsung/Sony/LG)
# all = select every visible bouquet checkbox in the selector modal
IPTVTUNE_BOUQUET_MODE=all
# Poll client-area email history until the account-ready email arrives.
# In practice the trial email lands in ~3 min, but iptvtune advertises "within 1-3 hours";
# default waits up to 1 hour, polling once a minute. Raise the max wait further if needed.
IPTVTUNE_EMAIL_POLL_SECONDS=60
IPTVTUNE_EMAIL_MAX_WAIT_SECONDS=3600
# Page-load resilience: timeout per navigation (keep below 120) and retries per page.
IPTVTUNE_PAGE_LOAD_TIMEOUT_SECONDS=90
IPTVTUNE_PAGE_LOAD_RETRIES=3
# Verified subject of the IPTVtune trial credentials email.
IPTVTUNE_READY_EMAIL_SUBJECT=IPTV Access Information
# Optional fallback if the ready email does not expose a portal URL cleanly
IPTVTUNE_PORTAL_HOST=
# Optional: push the extracted credentials into an existing IBO Player playlist.
# Reuses the shared IBOPLAYER_COOKIE set in the IBO Player section above.
IPTVTUNE_IBOPLAYER_ENABLED=False
IPTVTUNE_IBOPLAYER_PLAYLIST_URL_ID=6a299079a7f8755f5b94b6c0
IPTVTUNE_IBOPLAYER_PLAYLIST_NAME=iptvtune
# Second IBO Player device for the 08:00 run (--iboplayer-account 2).
# Separate device login: get the cookie and playlist URL id from browser DevTools on iboplayer.com.
IBOPLAYER_COOKIE_2=
IPTVTUNE_IBOPLAYER_PLAYLIST_URL_ID_2=
IPTVTUNE_IBOPLAYER_PLAYLIST_NAME_2=iptvtune 2

# ═══════════════════════════════════════════════════════════
# ViewTVY Automation Configuration
# ═══════════════════════════════════════════════════════════
# WHMCS store at https://viewtvy.com/billing/ ; single free "24hr Free Trial" product
# (no device/bouquet configuration). Credentials are read from the client-area Email History.
VIEWTVY_BASE_URL=https://viewtvy.com
# Billing subdirectory of the WHMCS install (used to build cart/clientarea/viewemail URLs).
VIEWTVY_BILLING_PATH=/billing
# Direct link to the trial product order page.
VIEWTVY_TRIAL_URL=https://viewtvy.com/billing/index.php?rp=/store/free-trial/24hr-free-trial
# Poll client-area email history until the credentials email arrives.
VIEWTVY_EMAIL_POLL_SECONDS=60
VIEWTVY_EMAIL_MAX_WAIT_SECONDS=3600
# Page-load resilience: timeout per navigation (keep below 120) and retries per page.
VIEWTVY_PAGE_LOAD_TIMEOUT_SECONDS=90
VIEWTVY_PAGE_LOAD_RETRIES=3
# Optional fallback if the credentials email does not expose a portal/server URL cleanly.
VIEWTVY_PORTAL_HOST=
# Optional exact subject of the credentials email. Leave blank to scan email-history rows
# for any subject containing trial/access/login/account/iptv/details/welcome/subscription.
VIEWTVY_READY_EMAIL_SUBJECT=
# Optional: push the extracted credentials into an existing IBO Player playlist.
# Reuses the shared IBOPLAYER_COOKIE / IBOPLAYER_COOKIE_2 set in the IBO Player sections above.
VIEWTVY_IBOPLAYER_ENABLED=False
VIEWTVY_IBOPLAYER_PLAYLIST_URL_ID=
VIEWTVY_IBOPLAYER_PLAYLIST_NAME=ViewTVY
# Second IBO Player device (--iboplayer-account 2). Uses IBOPLAYER_COOKIE_2 above.
VIEWTVY_IBOPLAYER_PLAYLIST_URL_ID_2=
VIEWTVY_IBOPLAYER_PLAYLIST_NAME_2=ViewTVY 2

# ═══════════════════════════════════════════════════════════
# TVCORN Trial Automation Configuration
# ═══════════════════════════════════════════════════════════
# Email backend for receiving the OTP + credentials: "procmail" (default) or "mailtm".
TVCORN_EMAIL_BACKEND=procmail
# Optional tuning (defaults shown):
# TVCORN_OTP_MAX_WAIT_SECONDS=300
# TVCORN_OTP_POLL_SECONDS=10
# TVCORN_GENERATION_MAX_WAIT_SECONDS=240
# Optional: push the extracted credentials into an existing IBO Player playlist.
# Reuses the shared IBOPLAYER_COOKIE set in the IBO Player section above
# (set TVCORN_IBOPLAYER_COOKIE only to override with a dedicated device).
TVCORN_IBOPLAYER_ENABLED=False
TVCORN_IBOPLAYER_PLAYLIST_URL_ID=
TVCORN_IBOPLAYER_PLAYLIST_NAME=tvcorn

# ═══════════════════════════════════════════════════════════
# UZEEN Playlist Updater Configuration
# ═══════════════════════════════════════════════════════════

# Uzeen M3U File URL
# The URL to fetch the Uzeen M3U playlist file
UZEEN_M3U_URL=http://uzeen.net/api/m3u/D67hZ8SegV

# IboPlayer Uzeen Playlist Configuration
# Playlist ID: The specific playlist ID in IboPlayer to update for Uzeen
IBOPLAYER_UZEEN_PLAYLIST_ID=6a08707dc7c4b3c03a03d600
# Playlist Name: Display name for the Uzeen playlist (optional, defaults to "Uzeen")
IBOPLAYER_UZEEN_PLAYLIST_NAME=Uzeen
# Note: IBOPLAYER_COOKIE is already configured above in the IBO Player section
